<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" in the manifest already blocks Android's
  classic backup path. This file covers Android 12+'s newer transfer/backup
  APIs the same way: exclude everything. A device-to-device transfer or a
  cloud backup copying Veil's encrypted vault file off-device, onto
  infrastructure Veil's threat model doesn't control, defeats the
  "never leaves the device unencrypted, and ideally never leaves it at
  all" design goal even though the vault file is itself encrypted at rest —
  the key derivation (Argon2id over the user's passphrase) is strong, but
  there is no reason to hand an attacker the ciphertext for free.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
